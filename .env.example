# Your warehouse connection. Copy to .env and edit:
#
#   cp .env.example .env
#
# .env is gitignored. It is the single source of truth for every mode: read by
# ./run.sh locally, and turned into a Kubernetes Secret by k8s/spinup.sh.
#
# Every setting below has a working default, so you only need to change what
# differs for you. With no .env at all the project runs on DuckDB.

# Which target in profiles.yml to use:
#   duckdb | postgres | redshift | snowflake | bigquery | databricks
DBT_TARGET=duckdb

# Schema (BigQuery: dataset) dbt writes into, and how many models build at once.
DBT_SCHEMA=analytics
DBT_THREADS=4

# --- Postgres / anything Postgres-compatible --------------------------------
DBT_PG_HOST=localhost
DBT_PG_PORT=5432
DBT_PG_USER=dbt
DBT_PG_PASSWORD=
DBT_PG_DATABASE=analytics

# --- Redshift ---------------------------------------------------------------
# DBT_REDSHIFT_HOST=your-cluster.abc123.us-east-1.redshift.amazonaws.com
# DBT_REDSHIFT_PORT=5439
# DBT_REDSHIFT_USER=dbt
# DBT_REDSHIFT_PASSWORD=
# DBT_REDSHIFT_DATABASE=analytics

# --- Snowflake --------------------------------------------------------------
# DBT_SNOWFLAKE_ACCOUNT=ab12345.us-east-1
# DBT_SNOWFLAKE_USER=dbt
# DBT_SNOWFLAKE_PASSWORD=
# DBT_SNOWFLAKE_ROLE=TRANSFORMER
# DBT_SNOWFLAKE_WAREHOUSE=COMPUTE_WH
# DBT_SNOWFLAKE_DATABASE=ANALYTICS

# --- BigQuery ---------------------------------------------------------------
# Also needs the service-account JSON; see "BigQuery" in the README.
# DBT_BIGQUERY_PROJECT=my-gcp-project
# DBT_BIGQUERY_LOCATION=US
# DBT_BIGQUERY_KEYFILE=/path/to/service-account.json

# --- Databricks -------------------------------------------------------------
# DBT_DATABRICKS_HOST=abc-123.cloud.databricks.com
# DBT_DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/abc123
# DBT_DATABRICKS_TOKEN=
# DBT_DATABRICKS_CATALOG=main

# --- DuckDB sandbox ---------------------------------------------------------
# DBT_DUCKDB_PATH=warehouse.duckdb
